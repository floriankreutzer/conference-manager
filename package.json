{
  "name": "conference-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:agents": "node scripts/check-agent-instructions.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:architecture": "node scripts/check-architecture.mjs && node scripts/check-modular-runtime.mjs",
    "check:persistence": "node scripts/check-production-persistence.mjs",
    "check:roles": "node scripts/check-tenant-role-administration.mjs",
    "check:static": "node scripts/check-static.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:design": "node scripts/check-design.mjs",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm run check:syntax && npm run check:agents && npm run check:i18n && npm run check:architecture && npm run check:persistence && npm run check:roles && npm run check:static && npm run check:secrets && npm run check:design && npm test",
    "audit": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  },
  "engines": {
    "node": ">=22"
  }
}
